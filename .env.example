NODE_ENV=development
PORT=3000
REALTIME_PORT=3001

DATABASE_URL=postgres://postgres:postgres@localhost:5432/disaster
REDIS_URL=redis://localhost:6379

# Generate a real one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Gemini (location text extraction only - never coordinates)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Nominatim (geocoder). Requires a unique identifying User-Agent - placeholders like "you@example.com" get HTTP 403.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=your-app-name/1.0 (contact)

# Mock external community service
COMMUNITY_API_URL=http://localhost:4000
# Optional: force a mock scenario (success | error | slow | empty)
COMMUNITY_API_SCENARIO=

CACHE_DISASTER_TTL_SECONDS=60
CACHE_REPORTS_TTL_SECONDS=120
CACHE_STALE_REPORTS_TTL_SECONDS=86400

EXTERNAL_API_TIMEOUT_MS=3000

LOCATION_MAX_RETRIES=3
LOCATION_RETRY_BASE_MS=1000

CORS_ORIGIN=*
